{
  "name": "engineering-portfolio-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "test": "vitest run --exclude .worktrees/** --exclude plugins/engineering-portfolio-builder/tests/browser/**",
    "test:unit": "vitest run --exclude .worktrees/** --exclude plugins/engineering-portfolio-builder/tests/browser/**",
    "test:browser": "playwright test --config playwright.config.ts",
    "typecheck": "node node_modules/typescript/lib/tsc.js -p tsconfig.scripts.json --noEmit",
    "validate": "node node_modules/typescript/lib/tsc.js -p tsconfig.scripts.json --noEmit && vitest run --exclude .worktrees/** --exclude plugins/engineering-portfolio-builder/tests/browser/**",
    "portfolio:build": "vite-node plugins/engineering-portfolio-builder/scripts/build-site.ts",
    "portfolio:package": "vite-node plugins/engineering-portfolio-builder/scripts/package-cloudbase.ts",
    "portfolio:qr": "vite-node plugins/engineering-portfolio-builder/scripts/generate-qr.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite-node": "3.2.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "adm-zip": "^0.6.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "vite": "^8.2.2",
    "zod": "^4.5.4"
  }
}
